	keywords = {Sensor fusion, Laser radar, Multitasking, Object detection, Point cloud compression, Semantics, Three-dimensional displays},
	pages = {2774--2781},
	file = {Full Text PDF:F\:\\Zotero\\translators\\storage\\A5GHE33J\\Liu 等 - 2023 - BEVFusion Multi-Task Multi-Sensor Fusion with Unified Bird's-Eye View Representation.pdf:application/pdf},
}

@article{xiang_multi-sensor_2023,
	title = {Multi-{Sensor} {Fusion} and {Cooperative} {Perception} for {Autonomous} {Driving}: {A} {Review}},
	volume = {15},
	issn = {1941-1197},
