@article{hao__nodate,
	title = {智能跟随小车室内主动避障研究},
	abstract = {In today's increasingly advanced technology, intelligent following vehicles can help people more easily complete cargo transportation tasks. In order to ensure the safe operation of intelligent following vehicles during the following task, various sensors are added and combined with theories from disciplines such as computer and artificial intelligence to perceive the external environment and control it to complete designated tasks. Obstacle detection methods and countermeasures are important factors in ensuring the safe operation of intelligent following vehicles, and have high research value. This article investigates the active obstacle avoidance and response methods for intelligent following vehicles in multi type obstacle environments. The main research work is as follows: (1) By analyzing the possible scenarios encountered in vehicle target following tasks, the A * artificial potential field fusion path planning algorithm was studied for obstacle avoidance during the following process, and simulation analysis was conducted to verify the feasibility of the fusion path planning algorithm. Based on the application scenario, the composition of the vehicle obstacle scanning system was determined and the obstacle avoidance strategy was written.},
